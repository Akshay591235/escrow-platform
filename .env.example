# Backend - Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/escrow-platform?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Razorpay (Test Mode Keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Platform Configuration
PLATFORM_ACCOUNT_ID=your_razorpay_account_id_for_receiving_fees
PLATFORM_PHONE=919876543210
PLATFORM_EMAIL=escrow@platform.com

# Frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
